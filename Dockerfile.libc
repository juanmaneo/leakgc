# Test images, one per C library (PLAN D73). Each image has the pinned Rust
# toolchain and the C compiler that the tests call as `cc`. The repository is
# mounted at run time, not copied in, and build output goes to a named volume
# per library, so the libraries never share build output or write root-owned
# files into the repository.
#
#   scripts/libc-tests.sh glibc
#   scripts/libc-tests.sh musl
#   scripts/libc-tests.sh cosmo
#   scripts/libc-tests.sh relibc
#
# Plain Dockerfile syntax only, so `docker build` and `podman build` both work.

ARG RUST_TOOLCHAIN=1.100.0

FROM gcc:16 AS glibc
ARG RUST_TOOLCHAIN
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_TOOLCHAIN}"
ENV PATH="/root/.cargo/bin:${PATH}" \
    CARGO_TARGET_DIR="/cargo-target"
WORKDIR /workspace
CMD ["cargo", "test", "--workspace", "--locked", "--no-fail-fast"]

FROM alpine:3.20 AS musl
ARG RUST_TOOLCHAIN
RUN apk add --no-cache bash curl ca-certificates gcc musl-dev
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_TOOLCHAIN}"
ENV PATH="/root/.cargo/bin:${PATH}" \
    CARGO_TARGET_DIR="/cargo-target"
WORKDIR /workspace
CMD ["cargo", "test", "--workspace", "--locked", "--no-fail-fast"]

# Cosmopolitan Libc (PLAN D72, D75). The toolchain comes from the GitHub release,
# pinned by its SHA-256. Its tools are APE files, so they run through the shim
# in scripts/cosmo-shim.sh (D85). The cosmo tests are ignored by `cargo test`,
# so this image runs only them.
FROM gcc:16 AS cosmo
ARG RUST_TOOLCHAIN
ARG COSMOCC_SHA256=85b8c37a406d862e656ad4ec14be9f6ce474c1b436b9615e91a55208aced3f44
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSfL -o /tmp/cosmocc.zip \
      https://github.com/jart/cosmopolitan/releases/download/4.0.2/cosmocc-4.0.2.zip \
    && echo "${COSMOCC_SHA256}  /tmp/cosmocc.zip" | sha256sum -c - \
    && unzip -q /tmp/cosmocc.zip -d /opt/cosmocc \
    && rm /tmp/cosmocc.zip
COPY scripts/cosmo-shim.sh /usr/local/bin/cosmo-shim.sh
RUN sh /usr/local/bin/cosmo-shim.sh /opt/cosmocc \
    && /opt/cosmocc/bin/cosmocc --version
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_TOOLCHAIN}"
# cosmocc goes last so that `cc`, which Rust's linker and the other tests use,
# stays the system compiler. Cosmopolitan's own tools are named with a target prefix.
ENV PATH="/root/.cargo/bin:${PATH}:/opt/cosmocc/bin" \
    CARGO_TARGET_DIR="/cargo-target"
WORKDIR /workspace
CMD ["cargo", "test", "--locked", "--test", "libc_cosmo", "--", "--ignored"]

# relibc, Redox OS's C library written in Rust (PLAN D74, beta). Its sysroot is
# built here from a pinned revision. The build uses the nightly that relibc's own
# rust-toolchain.toml names, which rustup installs on first use, so the default
# toolchain only builds cbindgen and runs the tests. The tests need the relibc
# feature, so this image runs only them.
FROM gcc:16 AS relibc
ARG RUST_TOOLCHAIN
ARG RELIBC_REV=c222551930b0cc1aacf8d04b0b449e078de63ece
ARG CBINDGEN_VERSION=0.29.4
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_TOOLCHAIN}"
ENV PATH="/root/.cargo/bin:${PATH}"
RUN cargo install cbindgen --version "${CBINDGEN_VERSION}" --locked
RUN git clone https://gitlab.redox-os.org/redox-os/relibc.git /opt/relibc \
    && git -C /opt/relibc checkout "${RELIBC_REV}" \
    && git -C /opt/relibc submodule update --init --recursive
# The build directory stays the default /opt/relibc/target. CARGO_TARGET_DIR is set
# only for the test run below, so it cannot redirect the sysroot build.
WORKDIR /opt/relibc
RUN make all TARGET=x86_64-unknown-linux-gnu CC=gcc LD=ld AR=ar NM=nm OBJCOPY=objcopy \
    && make install TARGET=x86_64-unknown-linux-gnu DESTDIR=/opt/relibc-sysroot
ENV LEAKGC_RELIBC_SYSROOT=/opt/relibc-sysroot \
    CARGO_TARGET_DIR="/cargo-target"
WORKDIR /workspace
CMD ["cargo", "test", "--locked", "--features", "relibc", "--test", "libc_relibc", "--", "--ignored"]
